#!/usr/bin/env bash

(return 0 2>/dev/null) && sourced=1 || sourced=0

_aqi_monitor()
{
    local cur=${COMP_WORDS[COMP_CWORD]}
    COMPREPLY=( $(compgen -W "start stop restart log json api status usage help" -- $cur) )
}
complete -F _aqi_monitor aqi_monitor

function aqi_monitor(){

function sensor_online(){
# Check device exists directly — dmesg check fails if sensor was present at boot
local dev_port=""
for candidate in /dev/ttyUSB0 /dev/ttyUSB1 /dev/myUSB; do
    if [[ -e "${candidate}" ]]; then
        dev_port="${candidate}"
        break
    fi
done
if [[ -z "${dev_port}" ]]; then
    echo "ERROR:DEVICE NOT FOUND : SDS011 Particulate Matter Sensor"
    return 2>/dev/null || exit
fi
echo " - SDS011 Particulate Matter Sensor CONNECTED : ${dev_port}"
# Export for docker-compose device mapping if non-default path
export SENSOR_DEV="${dev_port}"
}	# END OF sensor_online

cd /home/pi/pi_air_quality_monitor || { return 2>/dev/null || exit;  }
log=/tmp/sensor_logs/aqi_monitor.log
mkdir -p /tmp/sensor_logs
touch ${log}
pidfile=/tmp/aqimon.pid
is_running=$(docker ps |grep -E 'pi_air.*$')

function already_running(){
echo " - service is already running;try aqi_monitor restart";
echo "PID : $(cat "${pidfile}")"
echo "${is_running}";
}	# END OF already_running

case $1 in 
	start)
	  sensor_online
	  [[ -n "${is_running}" ]] && { already_running ; return 2>/dev/null || exit ; }
	  sleep 20
	  nohup docker-compose up >> ${log} 2>&1 & 
	  aqipid=$!
	  echo "${aqipid}" > ${pidfile}
	  echo -e "\n - AQI MONITOR SERVICE STARTED"
	;;
	stop)
	  docker ps | grep 'pi_air_quality_monitor' 2>&1 >/dev/null || { echo " - service not running"; return 2>/dev/null || exit ; }
	  docker-compose down
	  rm ${pidfile} 2>/dev/null
	;;
	status)
	  #set -x
	  sensor_online
	  docker ps | grep 'pi_air_quality_monitor' 2>/dev/null || echo " - service not running"
	  #set +x
	;;
	restart)
	  aqi_monitor stop
	  aqi_monitor start
	  sleep 5
	  aqi_monitor status
	;;
	log)
	  [[ -e "${log}" ]] || { echo " - $log file not found"; return; }
	  tail -F ${log}
	;;
	api|json)
	  which jq 2>&1 >/dev/null && \
		curl -s localhost:8000/api/ | jq . -c || \
		curl -s localhost:8000/api/
	;;
	usage|help|*)
		echo -e "${FUNCNAME[0]} [start|stop|status|api|json|restart|log|help|usage]"
		return
	;;
esac
}
export -f aqi_monitor

[[ "${sourced}" -eq 0 && -n "$@" ]] && aqi_monitor $@ || aqi_monitor usage

